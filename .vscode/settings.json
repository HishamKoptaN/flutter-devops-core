{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "00-core-main.yml": "00-core-*.yml",
    "10-build-android-artifacts.yml": "10-build-*.yml",
    "20-shorebird.yml": "20-shorebird-*.yml",
    "30-deploy-installer.yml": "30-*.yml",
    "40-distribute-android.yml": "40-*.yml",
    "50-env-dev.yml": "50-env-*.yml",
    "*.dart": "${capture}.g.dart, ${capture}.freezed.dart",
    "*.g.dart": "${capture}.dart",
    "*.freezed.dart": "${capture}.dart",
    "setup.iss": "installers/*.iss"
  },
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/**/*.yml"
  }
}
