{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    // � SETUP LAYER
    "00-core-main.yml": "00-core-*.yml,00-setup.yml,50-env-*.yml",
    
    // � DECISION + BUILD LAYER
    "20-shorebird.yml": "20-shorebird-*.yml,10-deploy-shorebird-android.yml,31-build-layer.yml,10-build-*.yml,20-build-*.yml",
    
    // � DISTRIBUTION LAYER
    "32-distribution-layer.yml": "30-deploy-*.yml,40-distribute-*.yml,30-upload-*.yml",
    
    // 🟪 PACKAGING LAYER
    "30-build-installer.yml": "20-prepare-installer.yml,30-package-*.yml",
    
    // 🌐 WEB PIPELINE
    "build-deploy-web.yml": "build-deploy-web.yml",
    "*.dart": "${capture}.g.dart, ${capture}.freezed.dart",
    "*.g.dart": "${capture}.dart",
    "*.freezed.dart": "${capture}.dart",
    "setup.iss": "installers/*.iss",
    "pubspec.yaml": "pubspec.lock, .metadata, .packages",
    "android/app/build.gradle.kts": "android/build.gradle.kts, android/settings.gradle.kts, android/gradle.properties",
    "ios/Runner.xcodeproj/project.pbxproj": "ios/Runner.xcodeproj/*.pbxproj, ios/Runner.xcodeproj/*.xcworkspace",
    "windows/runner/CMakeLists.txt": "windows/flutter/CMakeLists.txt, windows/CMakeLists.txt"
  },
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/**/*.yml"
  }
}
