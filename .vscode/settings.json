{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "00-core-main.yml": "00-*.yml",
    "20-shorebird-layer.yml": "20-*.yml",
    "30-build-installer.yml": "30-*.yml",
    "40-build-layer.yml": "40-*.yml",
    "50-distribution-layer.yml": "50-*.yml",
    "*.dart": "*.g.dart, *.freezed.dart",
    "*.g.dart": "*.dart",
    "*.freezed.dart": "*.dart",
    "setup.iss": "installers/*.iss",
    "pubspec.yaml": "pubspec.lock, .metadata, .packages",
    "android/app/build.gradle.kts": "android/build.gradle.kts, android/settings.gradle.kts, android/gradle.properties",
    "ios/Runner.xcodeproj/project.pbxproj": "ios/Runner.xcodeproj/*.pbxproj, ios/Runner.xcodeproj/*.xcworkspace",
    "windows/runner/CMakeLists.txt": "windows/flutter/CMakeLists.txt, windows/CMakeLists.txt"
  },
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/**/*.yml"
  }
}