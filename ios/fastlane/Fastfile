# Monkey Patch دقيق وشامل لـ OpenSSL 3.x
module OpenSSL
  class PKey
    class << self
      alias_method :orig_read, :read
      def read(data, *args, &block)
        orig_read(data, *args, &block)
      rescue OpenSSL::PKey::PKeyError, OpenSSL::PKey::ECError
        orig_read(data, *args, &block)
      end
    end

    class EC
      class << self
        alias_method :orig_new, :new
        def new(*args, &block)
          if args.first.is_a?(String)
            OpenSSL::PKey.read(args.first)
          else
            orig_new(*args, &block)
          end
        rescue => e
          if args.first.is_a?(String)
            OpenSSL::PKey.read(args.first)
          else
            raise e
          end
        end
      end
    end
  end
end

default_platform(:ios)
platform :ios do
  desc "Push a new release build to TestFlight or build IPA with automatic code signing"
  lane :build_signed_ipa do
    ENV.delete('APP_STORE_CONNECT_API_KEY')
    
    priv_key = ENV["APP_STORE_CONNECT_API_PRIVATE_KEY"]
    if priv_key && !priv_key.include?("\n")
      body = priv_key.gsub(/-----BEGIN.*?-----/, '').gsub(/-----END.*?-----/, '').gsub(/\s+/, '')
      priv_key = "-----BEGIN PRIVATE KEY-----\n" + body.scan(/.{1,64}/).join("\n") + "\n-----END PRIVATE KEY-----"
    end

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: priv_key,
      is_key_content_base64: false
    )
    
    # باقي الخطوات...
    get_provisioning_profile( 
      app_identifier: "com.muein.orders",
      distribution_type: "app-store"     
    )
    UI.message("Fastlane setup and certificate verification completed successfully!")
  end
end
